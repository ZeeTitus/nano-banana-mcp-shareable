# Copy to .dev.vars for local `wrangler dev`. .dev.vars is gitignored — never commit real keys.
# In production these are Worker secrets: `npx wrangler secret put <NAME>` (see SETUP.md).

# REQUIRED. Google AI Studio key with access to the Imagen 4 and Gemini image models.
# Get one at https://aistudio.google.com/apikey (billing-enabled project recommended).
GEMINI_API_KEY="your-gemini-api-key-here"

# RECOMMENDED in production. Hides the MCP endpoint behind a secret path: /mcp/<MCP_PATH_KEY>.
# Generate: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# Leave unset locally to use plain http://localhost:8787/mcp while developing.
# MCP_PATH_KEY="long-random-hex"

# RECOMMENDED in production. Requires this token on POST /upload (header x-upload-token or ?token=).
# Generate: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
# UPLOAD_TOKEN="random-hex"

# OPTIONAL. JobTread Pave grant key. When set, the job picker, Selections, and
# "Save to JobTread" turn on. Create in JobTread (Settings → API grants) under a
# dedicated user. Shown once; expires after 3 months unused.
# JOBTREAD_GRANT_KEY="your-jobtread-grant-key-here"

# Local override of the wrangler.jsonc var so stored image URLs point at the dev server.
PUBLIC_ORIGIN="http://localhost:8787"
